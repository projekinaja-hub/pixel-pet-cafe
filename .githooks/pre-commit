#!/bin/bash
# Test gate: no commit lands with a failing suite.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass when you need to: `git commit --no-verify`  or  PPC_SKIP_TESTS=1 git commit
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"

git diff --cached --name-only --diff-filter=ACM \
  | grep -qE '\.(swift|py)$|^Package\.swift$' || exit 0

if [ "${PPC_SKIP_TESTS:-0}" = "1" ]; then
    echo "pre-commit: PPC_SKIP_TESTS=1 — skipping tests"
    exit 0
fi

echo "pre-commit: running tests…"
cd "$ROOT" || exit 0

# The build database used to corrupt intermittently here: ~/Documents is a
# Google Drive sync root and DriveFS interferes with SQLite locking, which
# produced "accessing build database: disk I/O error" — and, far worse, let
# the run CONTINUE against the previous binary, so a pass or failure said
# nothing about the code being committed.
#
# tools/test.sh now builds in ~/Library/Caches, outside every sync root, so
# that cannot happen. The retry-and-purge dance that used to live here is gone
# with it; if this error ever reappears, the scratch path is being overridden
# back into a synced folder.
OUTPUT="$(./tools/test.sh 2>&1)"
if echo "$OUTPUT" | grep -q "disk I/O error"; then
    echo "pre-commit: build database corrupted — is PPC_SCRATCH pointing into a synced folder?" >&2
    exit 1
fi
if echo "$OUTPUT" | grep -qE "with [1-9][0-9]* failure|error: fatalError|error: compile"; then
    echo "──────────────────────────────────────────────"
    echo "pre-commit: TESTS FAILED — commit blocked."
    echo "$OUTPUT" | grep -E "XCTAssert|error: -\\[|with [1-9][0-9]* failure" \
        | grep -v "disk I/O error" | head -20
    echo "──────────────────────────────────────────────"
    echo "Fix the failures, or bypass with: git commit --no-verify"
    exit 1
fi

echo "pre-commit: $(echo "$OUTPUT" | grep -oE "Executed [0-9]+ tests" | tail -1) passed ✓"
exit 0
